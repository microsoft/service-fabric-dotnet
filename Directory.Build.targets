<Project>
  <!-- Set properties that require well-known properties not available in Directory.Build.props -->

  <!-- Common NuGet package settings -->
  <PropertyGroup Condition="'$(IsPackable)' == ''">
    <IsPackable Condition="'$(OutputType)' == 'Library'">true</IsPackable>
    <IsPackable Condition="'$(OutputType)' == 'Exe'">false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols Condition="'$(IncludeSymbols)' == ''">true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DocumentationFile>$(OutputPath)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Publish dependencies to the build output for signing -->
    <PublishDir>$(OutputPath)</PublishDir>
  </PropertyGroup>

  <!--
    Generate strongly-typed resource accessors at build time.
    <EmbeddedResource Update="Strings.resx" StronglyTypedLanguage="CSharp" />
    https://learn.microsoft.com/visualstudio/msbuild/generateresource-task
  -->
  <ItemGroup>
    <EmbeddedResource Update="@(EmbeddedResource)">
      <StronglyTypedNamespace Condition="'%(StronglyTypedLanguage)' == 'CSharp' and '%(StronglyTypedNamespace)' == ''">$(RootNamespace)</StronglyTypedNamespace>
      <StronglyTypedClassName Condition="'%(StronglyTypedLanguage)' == 'CSharp' and '%(StronglyTypedClassName)' == ''">%(Filename)</StronglyTypedClassName>
      <LogicalName Condition="'%(StronglyTypedLanguage)' == 'CSharp' and '%(LogicalName)' == ''">%(StronglyTypedNamespace).%(StronglyTypedClassName).resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
