<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Microsoft.ServiceFabric.Services.Communication.AspNetCore</RootNamespace>
    <TargetFrameworks>net462;net8.0</TargetFrameworks>
    <!-- MSB3277 on net8.0: this build finds the System.Diagnostics.DiagnosticSource 10 that Diagnostics keeps private next to
         Microsoft.ServiceFabric.Diagnostics.dll, newer than .NET 8's. Builds of apps that use the packages don't, so they don't warn. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net8.0'">$(NoWarn);MSB3277</NoWarn>
    <Description>HTTP.sys-based communication listener for ASP.NET Core applications on Service Fabric.</Description>
  </PropertyGroup>
  <Import Project="..\..\properties\service_fabric_managed_common.props" />
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(TargetFramework)' != 'net462'" />
    <PackageReference Include="Microsoft.AspNetCore.Server.HttpSys" Condition="'$(TargetFramework)' == 'net462'" />
    <PackageReference Include="Microsoft.ServiceFabric" />
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AspNetCore\Microsoft.ServiceFabric.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="SR.resx" StronglyTypedLanguage="CSharp" />
  </ItemGroup>
</Project>
