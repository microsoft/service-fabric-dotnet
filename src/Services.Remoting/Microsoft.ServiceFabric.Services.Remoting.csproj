<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net462</TargetFrameworks>
    <!-- MSB3277 on net8.0: this build finds the System.Diagnostics.DiagnosticSource 10 that Diagnostics keeps private next to
         Microsoft.ServiceFabric.Diagnostics.dll, newer than .NET 8's. Builds of apps that use the packages don't, so they don't warn. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net8.0'">$(NoWarn);MSB3277</NoWarn>
    <Description>Remoting APIs for type-safe RPC communication between Service Fabric services.</Description>
  </PropertyGroup>
  <Import Project="..\..\properties\service_fabric_managed_common.props" />
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Constants\Microsoft.ServiceFabric.Constants.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\FabricTransport\Microsoft.ServiceFabric.FabricTransport.csproj" />
    <ProjectReference Include="..\Diagnostics\Microsoft.ServiceFabric.Diagnostics.csproj" />
    <ProjectReference Include="..\Services\Microsoft.ServiceFabric.Services.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="SR.resx" StronglyTypedLanguage="CSharp" />
  </ItemGroup>
</Project>
