<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net10.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ServiceFabric.Actors" />
    <PackageReference Include="Microsoft.ServiceFabric.AspNetCore.Kestrel" />
  </ItemGroup>
  <Target Name="RequireSdkPackageVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(ServiceFabricSdkVersion)' == ''" Text="Run eng\TestPackageConsumers.ps1 after packing the SDK." />
  </Target>
</Project>
